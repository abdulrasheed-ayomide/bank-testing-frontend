# LOCAL DEVELOPMENT (npm run dev):
# Use a relative path — the Vite dev server proxy (see vite.config.js)
# forwards it to your local backend at http://localhost:5000.
VITE_API_URL=/api/v1

# PRODUCTION (Vercel):
# There is NO backend proxy in the deployed static build — vercel.json only
# rewrites unmatched paths to index.html for client-side routing. A relative
# VITE_API_URL in production means the browser calls your OWN frontend
# domain for /api/v1/*, which Vercel's catch-all rewrite serves as the React
# app instead of reaching Express — every login and API call would silently
# fail. In the Vercel project's environment variables (Production AND
# Preview, since they can differ), set the FULL backend URL instead:
#
#   VITE_API_URL=https://bank-testing-backend.onrender.com/api/v1
#
# Vite bakes this value into the build at build time, so double-check it
# under both the assigned *.vercel.app domain and any custom domain if
# they've ever behaved differently — that's usually a sign one of them is
# using a different environment scope in the Vercel dashboard.
